# Copy to backend/.env and fill in. NEVER commit .env (it is in .gitignore).

# ---- Core -------------------------------------------------------------
# development | production.  Production refuses to start with an unsafe config.
APP_ENV=development
DATABASE_URL=sqlite:///./hospital_ai.db

# REQUIRED in production. 32+ random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in development, a random key is used per process (logins reset on restart).
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5600,http://localhost:5600

# ---- LLM providers (only providers with a key are used) ---------------
LLM_PRIMARY_PROVIDER=gemini
LLM_SECONDARY_PROVIDER=
LLM_TERTIARY_PROVIDER=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

HCN_API_KEY=
HCN_MODEL=DeepSeek-V4-Flash
HCN_BASE_URL=https://api.hcnsec.cn/v1

ENABLE_NATIVE_TOOL_ROUTING=false
LLM_CIRCUIT_BREAKER_ENABLED=true

# ---- Abuse protection -------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_PUBLIC_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
VERIFY_MAX_FAILURES=5
VERIFY_LOCKOUT_MINUTES=15
# true only when the API runs behind YOUR reverse proxy (so X-Forwarded-For can be trusted)
TRUST_PROXY_HEADERS=false

# ---- Patient verification for cancel / reschedule / status ------------
# Production needs EITHER OTP with real SMS delivery (recommended) ...
OTP_REQUIRED_FOR_SENSITIVE_ACTIONS=false
OTP_DELIVERY_MODE=console
OTP_SMS_WEBHOOK_URL=
OTP_SMS_WEBHOOK_TOKEN=
OTP_HASH_SECRET=
# ... or an explicit, conscious opt-out:
ALLOW_INSECURE_PUBLIC_ACTIONS=false

# ---- Knowledge base ----------------------------------------------------
MAX_UPLOAD_MB=10
